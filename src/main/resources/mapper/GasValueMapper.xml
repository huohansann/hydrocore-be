<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.siact.module.control.mapper.GasValueMapper">
    <insert id="insertBatch">
        insert into gas_value(`id`, `time`, `data_key`, `data_code`, `gas_value`)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.time}, #{item.dataKey}, #{item.dataCode}, #{item.gasValue})
        </foreach>
    </insert>
</mapper>
